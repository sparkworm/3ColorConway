#version 430 core

// One 16x16 group gives each invocation a two-dimensional grid position.
layout(local_size_x = 16, local_size_y = 16) in;

// Read one generation and write the next into a distinct texture. Keeping
// current and next separate prevents in-pass writes from affecting neighbors.
layout(r32ui, binding = 0) readonly uniform uimage2D currentState;
layout(r32ui, binding = 1) writeonly uniform uimage2D nextState;

// Grid dimensions in columns and rows.
uniform ivec2 gridSize;

// Each row gives source-channel weights for one output channel.
uniform ivec3 redWeights;
uniform ivec3 greenWeights;
uniform ivec3 blueWeights;

// Inclusive weighted-score bounds, indexed by output channel.
uniform ivec3 birthMinimum;
uniform ivec3 birthMaximum;
uniform ivec3 survivalMinimum;
uniform ivec3 survivalMaximum;

void main() {
    // gl_GlobalInvocationID identifies this invocation's grid cell.
    ivec2 cell = ivec2(gl_GlobalInvocationID.xy);

    // Rounded-up dispatch dimensions leave extra invocations around the edges;
    // ignore any invocation whose cell lies outside the actual grid.
    if (any(greaterThanEqual(cell, gridSize))) {
        return;
    }

    // Count each RGB bit independently in the Moore neighborhood.
    ivec3 channelCounts = ivec3(0);
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            // Skip the center cell because it is not one of its own neighbors.
            if (x == 0 && y == 0) {
                continue;
            }

            ivec2 neighbor = cell + ivec2(x, y);
            // Off-grid neighbors contribute no channel bits.
            if (all(greaterThanEqual(neighbor, ivec2(0))) &&
                all(lessThan(neighbor, gridSize))) {
                uint neighborState = imageLoad(currentState, neighbor).r;
                // Extract each color bit and add it to that channel's neighbor count.
                channelCounts += ivec3(
                    int(neighborState & 1u),
                    int((neighborState >> 1u) & 1u),
                    int((neighborState >> 2u) & 1u));
            }
        }
    }
    // Apply each output channel's own weights to the red, green, and blue
    // neighbor counts. The resulting integer scores may be negative.
    ivec3 scores = ivec3(
        redWeights.x * channelCounts.x + redWeights.y * channelCounts.y +
            redWeights.z * channelCounts.z,
        greenWeights.x * channelCounts.x + greenWeights.y * channelCounts.y +
            greenWeights.z * channelCounts.z,
        blueWeights.x * channelCounts.x + blueWeights.y * channelCounts.y +
            blueWeights.z * channelCounts.z);
    uint current = imageLoad(currentState, cell).r;
    uint next = 0u;
    for (int channel = 0; channel < 3; ++channel) {
        // A channel already present must meet its survival range; an absent
        // channel must meet its birth range. Both bounds are inclusive.
        bool present = (current & (1u << uint(channel))) != 0u;
        bool inRange = present
            ? scores[channel] >= survivalMinimum[channel] &&
                  scores[channel] <= survivalMaximum[channel]
            : scores[channel] >= birthMinimum[channel] &&
                  scores[channel] <= birthMaximum[channel];
        if (inRange) {
            // Set this channel's bit in the next cell's RGB mask.
            next |= 1u << uint(channel);
        }
    }
    // Write all three independently evaluated channels as one packed state.
    imageStore(nextState, cell, uvec4(next));
}
